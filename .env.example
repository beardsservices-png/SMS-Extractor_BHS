# Claude API key — from console.anthropic.com
ANTHROPIC_API_KEY=

# ntfy topic — same one used by bhs-memory-server (e.g. beards-bhs-calls-8703)
NTFY_TOPIC=

# ntfy server URL — leave as default unless using self-hosted ntfy
NTFY_URL=https://ntfy.sh

# ntfy bearer token — only needed if your topic requires authentication
NTFY_TOKEN=

# Webhook secret — added as ?token= query param in SMS Forwarder URL
# Protects the /sms endpoint from random internet traffic
WEBHOOK_SECRET=

# Brian's own mobile number — used to recognize forwarded *outgoing* texts so
# his replies attach to the customer's thread instead of starting a new one.
# Any format works: +18703211072, 8703211072, (870) 321-1072
OWNER_PHONE=

# Hours of silence before a thread is marked complete and a final card fires
THREAD_TTL_HOURS=4

# Port — Railway sets this automatically; leave blank for local dev (defaults to 8000)
PORT=

# Path to SQLite database
# Railway: set to /data/bhs_sms.db and add a persistent volume mounted at /data
# Local: leave blank (defaults to ./bhs_sms.db)
DATABASE_PATH=
